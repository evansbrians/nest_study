[Unit]
Description=nest_study nightly Sheets->DB batch load (stub)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nestapi
Group=nestapi
WorkingDirectory=/opt/nest-api/server
Environment=NEST_DB_PATH=/opt/nest-api/server/nest_study.sqlite
ExecStart=/usr/bin/Rscript /opt/nest-api/server/nightly_load.R
